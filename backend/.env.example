# Project Metadata
PROJECT_NAME="Personal AI Core"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (Neon PostgreSQL asyncpg URL)
# Example Neon: postgresql+asyncpg://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/personal_ai_core"
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Security (Generate a secure random key for production in Phase 1)
SECRET_KEY="temporary-dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
